+#include "SDL_internal.h"
+
+#ifndef SDL_ps4audio_h_
+#define SDL_ps4audio_h_
+
+#include "../SDL_sysaudio.h"
+
+// Buffers handed to the console one after another: sceAudioOutOutput() returns once the previous
+// one has been consumed, so the one being filled is never the one being played.
+#define PS4AUDIO_NUM_BUFFERS 3
+
+struct SDL_PrivateAudioData
+{
+    int port;                                    // sceAudioOut handle
+    Uint8 *rawbuf;                               // the raw allocated mixing buffer
+    Uint8 *mixbufs[PS4AUDIO_NUM_BUFFERS];        // individual mixing buffers
+    int next_buffer;                             // index of the next available mixing buffer
+};
+
+#endif // SDL_ps4audio_h_
