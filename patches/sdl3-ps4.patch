+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+#include "SDL_internal.h"
+
+// PlayStation 4 audio output (homebrew, OpenOrbis headers; link with -lSceAudioOut).
+// The "AudioOut" system module must be loaded by the application before SDL opens a device.
+
+#ifdef SDL_AUDIO_DRIVER_PS4
+
+#include "../SDL_sysaudio.h"
+#include "SDL_ps4audio.h"
+
+#include <orbis/AudioOut.h>
+#include <orbis/_types/errors.h>
+#include <orbis/_types/user.h>
+
+// sceAudioOutOpen() takes a block length of 256 * n sample frames, n = 1..8 (5.3 - 42.7 ms at 48 kHz)
+#define PS4AUDIO_GRAIN      256
+#define PS4AUDIO_MIN_FRAMES 256
+#define PS4AUDIO_MAX_FRAMES 2048
+
+#define PS4AUDIO_PORT_MAIN  0   // ORBIS_AUDIO_OUT_PORT_TYPE_MAIN
+#define PS4AUDIO_FREQ       48000
+#define PS4AUDIO_VOLUME_ALL 0x03 // left + right channel flags (sceAudioOutSetVolume)
+#define PS4AUDIO_VOLUME_MAX 0x8000
+
+static bool PS4AUDIO_OpenDevice(SDL_AudioDevice *device)
+{
+    if (device->recording) {
+        return SDL_SetError("PS4 audio: recording is not supported");
+    }
+
+    device->hidden = (struct SDL_PrivateAudioData *)SDL_calloc(1, sizeof(*device->hidden));
+    if (!device->hidden) {
+        return false;
+    }
+    device->hidden->port = -1;
+
+    // The main port plays 48 kHz stereo; SDL converts whatever the application asked for.
+    device->spec.freq = PS4AUDIO_FREQ;
+    device->spec.channels = 2;
+    device->spec.format = SDL_AUDIO_S16LE;
+
+    // The block length must be a multiple of 256 sample frames, 256 to 2048.
+    int frames = ((device->sample_frames + PS4AUDIO_GRAIN - 1) / PS4AUDIO_GRAIN) * PS4AUDIO_GRAIN;
+    frames = SDL_clamp(frames, PS4AUDIO_MIN_FRAMES, PS4AUDIO_MAX_FRAMES);
+    device->sample_frames = frames;
+
+    // Update the fragment size as size in bytes.
+    SDL_UpdatedAudioDeviceFormat(device);
+
+    const int mixlen = device->buffer_size * PS4AUDIO_NUM_BUFFERS;
+    device->hidden->rawbuf = (Uint8 *)SDL_aligned_alloc(256, mixlen);
+    if (!device->hidden->rawbuf) {
+        return SDL_SetError("Couldn't allocate mixing buffer");
+    }
+    SDL_memset(device->hidden->rawbuf, device->silence_value, mixlen);
+    for (int i = 0; i < PS4AUDIO_NUM_BUFFERS; i++) {
+        device->hidden->mixbufs[i] = &device->hidden->rawbuf[i * device->buffer_size];
+    }
+
+    const int port = sceAudioOutOpen(ORBIS_USER_SERVICE_USER_ID_SYSTEM, PS4AUDIO_PORT_MAIN, 0,
+                                     (uint32_t)device->sample_frames, (uint32_t)device->spec.freq,
+                                     ORBIS_AUDIO_OUT_PARAM_FORMAT_S16_STEREO);
+    if (port < 0) {
+        return SDL_SetError("Couldn't open audio out port: 0x%x", (unsigned int)port);
+    }
+    device->hidden->port = port;
+
+    int vols[2] = { PS4AUDIO_VOLUME_MAX, PS4AUDIO_VOLUME_MAX };
+    sceAudioOutSetVolume(port, PS4AUDIO_VOLUME_ALL, vols);
+
+    return true;
+}
+
+// sceAudioOutOutput() blocks until the console can take the block, which paces the audio thread:
+// no WaitDevice is needed.
+static bool PS4AUDIO_PlayDevice(SDL_AudioDevice *device, const Uint8 *buffer, int buflen)
+{
+    const int ret = sceAudioOutOutput(device->hidden->port, buffer);
+    if (ret < 0) {
+        return SDL_SetError("sceAudioOutOutput failed: 0x%x", (unsigned int)ret);
+    }
+    return true;
+}
+
+static Uint8 *PS4AUDIO_GetDeviceBuf(SDL_AudioDevice *device, int *buffer_size)
+{
+    Uint8 *buffer = device->hidden->mixbufs[device->hidden->next_buffer];
+    device->hidden->next_buffer = (device->hidden->next_buffer + 1) % PS4AUDIO_NUM_BUFFERS;
+    return buffer;
+}
+
+static void PS4AUDIO_CloseDevice(SDL_AudioDevice *device)
+{
+    if (device->hidden) {
+        if (device->hidden->port >= 0) {
+            sceAudioOutClose(device->hidden->port);
+            device->hidden->port = -1;
+        }
+        if (device->hidden->rawbuf) {
+            SDL_aligned_free(device->hidden->rawbuf); // this uses SDL_aligned_alloc(), not SDL_malloc()
+            device->hidden->rawbuf = NULL;
+        }
+        SDL_free(device->hidden);
+        device->hidden = NULL;
+    }
+}
+
+static bool PS4AUDIO_Init(SDL_AudioDriverImpl *impl)
+{
+    // Only the first caller in the process initializes the library; a second call is not an error.
+    const int ret = sceAudioOutInit();
+    if (ret < 0 && (unsigned int)ret != ORBIS_AUDIO_OUT_ERROR_ALREADY_INIT) {
+        return SDL_SetError("sceAudioOutInit failed: 0x%x", (unsigned int)ret);
+    }
+
+    impl->OpenDevice = PS4AUDIO_OpenDevice;
+    impl->PlayDevice = PS4AUDIO_PlayDevice;
+    impl->GetDeviceBuf = PS4AUDIO_GetDeviceBuf;
+    impl->CloseDevice = PS4AUDIO_CloseDevice;
+    impl->OnlyHasDefaultPlaybackDevice = true;
+    return true; // this audio target is available.
+}
+
+AudioBootStrap PS4AUDIO_bootstrap = {
+    "ps4", "PS4 audio driver", PS4AUDIO_Init, false, false
+};
+
+#endif // SDL_AUDIO_DRIVER_PS4
